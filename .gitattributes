# Normalize line endings
* text=auto eol=lf

# Windows-specific scripts are stored as CRLF and never converted (-text), so archives match the repository byte for byte
*.ps1 -text
*.cmd -text
*.bat -text
*.sln -text

# C# sources
*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.md text eol=lf

# Binary
*.png binary
*.ico binary
*.exe binary
