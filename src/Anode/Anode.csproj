<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Self-contained releases must not inherit an old runtime from a developer's SDK. -->
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>anode</AssemblyName>
    <RootNamespace>Anode</RootNamespace>
    <Version>0.9.0</Version>
    <Company>Anode</Company>
    <Product>Anode</Product>
    <AssemblyTitle>Anode background Windows desktop</AssemblyTitle>
    <Description>Background Windows desktop for AI agents: native GUI automation, screenshots and app testing.</Description>
    <Copyright>Copyright (c) 2026 skulitom. MIT License.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\anode.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <!-- A console-attached WinExe: shows a window for the viewer but keeps stdout
         usable for the CLI and the MCP stdio server. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\skills\anode-desktop\SKILL.md" LogicalName="Anode.AgentSkill" />
    <!-- The viewer and tray select sizes from this multi-frame icon at run time. -->
    <EmbeddedResource Include="..\..\assets\anode.ico" LogicalName="Anode.Icon" />
    <Content Include="..\..\skills\anode-desktop\**\*" Link="skills\anode-desktop\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\scripts\connect-agents.ps1" Link="connect-agents.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- WPF supplies UI Automation and the opt-in interoperability test fixture. -->
    <Using Include="System.IO" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

</Project>
