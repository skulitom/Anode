{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "anode",
  "displayName": "Anode background Windows desktop",
  "version": "0.5.0",
  "description": "Background Windows desktop for AI agents: native GUI automation, screenshots and app testing.",
  "author": {
    "name": "skulitom",
    "url": "https://github.com/skulitom"
  },
  "homepage": "https://github.com/skulitom/Anode#readme",
  "repository": "https://github.com/skulitom/Anode",
  "license": "MIT",
  "keywords": [
    "windows",
    "desktop-automation",
    "ui-automation",
    "gui-testing",
    "screenshots",
    "background-desktop",
    "mcp"
  ],
  "mcpServers": {
    "anode": {
      "command": "anode",
      "args": ["mcp"],
      "timeout": 420000
    }
  }
}
